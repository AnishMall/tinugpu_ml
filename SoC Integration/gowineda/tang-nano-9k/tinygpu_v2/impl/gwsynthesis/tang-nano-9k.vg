module neorv32_test_setup_bootloader (
  clk_i,
  rstn_i,
  gpio_o,
  uart0_txd_o,
  uart0_rxd_i
)
;
input clk_i;
input rstn_i;
output [5:0] gpio_o;
output uart0_txd_o;
input uart0_rxd_i;
wire clk_i_d;
wire rstn_i_d;
wire uart0_rxd_i_d;
wire uart0_txd_o_d;
wire [5:0] gpio_o_d;
wire VCC;
wire GND;
  IBUF clk_i_ibuf (
    .O(clk_i_d),
    .I(clk_i) 
);
  IBUF rstn_i_ibuf (
    .O(rstn_i_d),
    .I(rstn_i) 
);
  IBUF uart0_rxd_i_ibuf (
    .O(uart0_rxd_i_d),
    .I(uart0_rxd_i) 
);
  OBUF gpio_o_0_obuf (
    .O(gpio_o[0]),
    .I(gpio_o_d[0]) 
);
  OBUF gpio_o_1_obuf (
    .O(gpio_o[1]),
    .I(gpio_o_d[1]) 
);
  OBUF gpio_o_2_obuf (
    .O(gpio_o[2]),
    .I(gpio_o_d[2]) 
);
  OBUF gpio_o_3_obuf (
    .O(gpio_o[3]),
    .I(gpio_o_d[3]) 
);
  OBUF gpio_o_4_obuf (
    .O(gpio_o[4]),
    .I(gpio_o_d[4]) 
);
  OBUF gpio_o_5_obuf (
    .O(gpio_o[5]),
    .I(gpio_o_d[5]) 
);
  OBUF uart0_txd_o_obuf (
    .O(uart0_txd_o),
    .I(uart0_txd_o_d) 
);
  neorv32_top neorv32_top_inst (
    .clk_i_d(clk_i_d),
    .rstn_i_d(rstn_i_d),
    .uart0_rxd_i_d(uart0_rxd_i_d),
    .uart0_txd_o_d(uart0_txd_o_d),
    .gpio_o_d(gpio_o_d[5:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* neorv32_test_setup_bootloader */
