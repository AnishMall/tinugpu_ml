module neorv32_test_setup_bootloader (
  clk_i,
  rst_i,
  gpio_o,
  uart0_txd_o,
  uart0_rxd_i
)
;
input clk_i;
input rst_i;
output [5:0] gpio_o;
output uart0_txd_o;
input uart0_rxd_i;
wire clk_i_d;
wire rst_i_d;
wire uart0_rxd_i_d;
wire gpio_o_d_5_4;
wire gpio_o_d_4_4;
wire gpio_o_d_3_4;
wire gpio_o_d_2_4;
wire gpio_o_d_1_4;
wire gpio_o_d_0_4;
wire uart0_txd_o_d;
wire [5:0] con_gpio_out;
wire VCC;
wire GND;
  IBUF clk_i_ibuf (
    .O(clk_i_d),
    .I(clk_i) 
);
  IBUF rst_i_ibuf (
    .O(rst_i_d),
    .I(rst_i) 
);
  IBUF uart0_rxd_i_ibuf (
    .O(uart0_rxd_i_d),
    .I(uart0_rxd_i) 
);
  OBUF gpio_o_0_obuf (
    .O(gpio_o[0]),
    .I(gpio_o_d_0_4) 
);
  OBUF gpio_o_1_obuf (
    .O(gpio_o[1]),
    .I(gpio_o_d_1_4) 
);
  OBUF gpio_o_2_obuf (
    .O(gpio_o[2]),
    .I(gpio_o_d_2_4) 
);
  OBUF gpio_o_3_obuf (
    .O(gpio_o[3]),
    .I(gpio_o_d_3_4) 
);
  OBUF gpio_o_4_obuf (
    .O(gpio_o[4]),
    .I(gpio_o_d_4_4) 
);
  OBUF gpio_o_5_obuf (
    .O(gpio_o[5]),
    .I(gpio_o_d_5_4) 
);
  OBUF uart0_txd_o_obuf (
    .O(uart0_txd_o),
    .I(uart0_txd_o_d) 
);
  INV gpio_o_d_5_s0 (
    .O(gpio_o_d_5_4),
    .I(con_gpio_out[5]) 
);
  INV gpio_o_d_4_s0 (
    .O(gpio_o_d_4_4),
    .I(con_gpio_out[4]) 
);
  INV gpio_o_d_3_s0 (
    .O(gpio_o_d_3_4),
    .I(con_gpio_out[3]) 
);
  INV gpio_o_d_2_s0 (
    .O(gpio_o_d_2_4),
    .I(con_gpio_out[2]) 
);
  INV gpio_o_d_1_s0 (
    .O(gpio_o_d_1_4),
    .I(con_gpio_out[1]) 
);
  INV gpio_o_d_0_s0 (
    .O(gpio_o_d_0_4),
    .I(con_gpio_out[0]) 
);
  neorv32_top neorv32_top_inst (
    .clk_i_d(clk_i_d),
    .rst_i_d(rst_i_d),
    .uart0_rxd_i_d(uart0_rxd_i_d),
    .uart0_txd_o_d(uart0_txd_o_d),
    .con_gpio_out(con_gpio_out[5:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* neorv32_test_setup_bootloader */
