    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,\io_req.data [3:0]}),
    .BLKSEL({GND,GND,GND}),
    .AD({\io_req.addr [13:2],GND,GND}),
